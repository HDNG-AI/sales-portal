[Unit]
Description=Publish qualified storefront staging revision
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/sales-portal-staging/publish.py --config /etc/sales-portal-staging/config.json --apply
TimeoutStartSec=45min
TimeoutStopSec=5min
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
